[gd_scene format=3 uid="uid://dfh6wl7vf7owh"]

[sub_resource type="GDScript" id="GDScript_aikj4"]
resource_name = "Title"
script/source = "extends Node

func _ready():
	if global.get_frist():
		if global.has_method(\"set_player_name\"):
			global.set_player_name(\"BOYFRIED\")
		else:
			global.player_name = \"BOYFRIED\"
		scene_changer.enter_room_default()
		return
	var target := \"res://Core/DefaultScene/save_loader.tscn\"
	var container = global.get_scene_container()
	if container:
		container.change_scene_to_file(target)
	else:
		get_tree().change_scene_to_file(target)
"

[node name="title" type="Node" unique_id=958011076]
